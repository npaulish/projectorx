include CONTRIBUTING.md
include HISTORY.md
include LICENSE
include README.md
include src/projectorx/required_orbitals.json

# Tests (and their third-party data, see tests/data/README.md) stay in the
# git repository only; they are not shipped in the sdist or the wheel.
prune tests
recursive-exclude * __pycache__
recursive-exclude * *.py[co]

recursive-include docs *.md Makefile *.jpg *.png *.gif
